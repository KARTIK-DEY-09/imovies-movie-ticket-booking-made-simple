# ===================================================
# iMovies — Server Environment Configuration Template
# ===================================================

# Port to bind the Express and Socket.IO server (Default: 3000)
PORT=3000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# ---------------------------------------------------
# Database Configuration (Mongoose / MongoDB)
# ---------------------------------------------------
# For Local MongoDB:
# MONGO_URI="mongodb://127.0.0.1:27017/imovies"
#
# For MongoDB Atlas Cloud Database:
# MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority"
#
# NOTE: If left blank in development, the server will automatically
# launch a local embedded MongoMemoryServer engine for zero-config testing.
MONGO_URI=""

# ---------------------------------------------------
# Security & JWT Configuration
# ---------------------------------------------------
# A long, cryptographically strong random string for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_secret_key_for_jwt_2026

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------
# Initial Administrator Account
# ---------------------------------------------------
# Seed script creates this administrator if not already present
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ---------------------------------------------------
# Payment Mode
# ---------------------------------------------------
# Set to true to enable simulated demo payment flow for testing
DEMO_PAYMENTS_ENABLED=true
